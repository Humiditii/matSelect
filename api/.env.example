# --- Server ---
PORT=4000
WEB_ORIGIN=http://localhost:3000
NODE_ENV=development
SERVICE_NAME=matselect-api
# Also log to the console when NODE_ENV=prod (needed on Render)
LOG_CONSOLE=

# --- Database (MongoDB) ---
DB_URL=mongodb://127.0.0.1:27017/matselect

# --- Claude ---
# Server key. Leave empty to let users supply their own key from the web app;
# with no key at all, built-in demo data is used.
ANTHROPIC_API_KEY=
# Set to "mock" to force demo data even when keys are available.
LLM_PROVIDER=
LLM_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
LLM_EFFORT=medium
# Server-side refusal fallback; empty = on for models that support it
LLM_FALLBACKS=
LLM_TIMEOUT_MS=120000
MATERIALS_PER_FAMILY=10

# --- Engine ---
MC_SAMPLES=1000

# --- Protection ---
RATE_LIMIT_PER_MIN=30
